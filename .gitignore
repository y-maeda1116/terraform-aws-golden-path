# Local .terraform directories
.terraform/
.terraform.lock.hcl.d/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive values
*.tfvars
!terraform.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets — never commit
.env
.env.*
.env.local
.env.*.local

# Plan files
*.tfplan

# OS / editor
.DS_Store
.idea/
.vscode/

# Lambda build artifacts
*.py.zip
